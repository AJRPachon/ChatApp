# Copy to .maestro/.env (gitignored) and fill in. Read by scripts/run-suite.ps1 and
# scripts/run-multidevice.ps1, which pass every KEY=VALUE to maestro as `-e KEY=VALUE`.

# QA accounts (email/password sign-in; usernames already set up)
QA_EMAIL=
QA_PASSWORD=
QA_USERNAME=claudeqa
QA_NAME=
QA2_EMAIL=
QA2_PASSWORD=
QA2_USERNAME=claudeqa2
QA2_NAME=
QA3_EMAIL=
QA3_PASSWORD=
QA3_USERNAME=claudeqa3
QA3_NAME=
# Persistent group shared by the QA accounts (created by flows/00_setup if missing)
QA_GROUP=Maestro Test Group

# Disposable accounts (destructive flows) — scripts/qa-accounts.ps1 only. NEVER commit or put in CI.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DISPOSABLE_PASSWORD=
